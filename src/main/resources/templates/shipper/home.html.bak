<!DOCTYPE html>Add commentMore actions
<html xmlns:th="http://www.thymeleaf.org"
      xmlns:layout="http://www.ultraq.net.nz/thymeleaf/layout"
      layout:decorate="~{shared/layout/base}">
<head>
    <title>Hồ Sơ Shipper</title>
    <link rel="stylesheet" th:href="@{/css/shipper/profile.css}">
    <style>
        /* Reset mạnh mẽ cho tất cả các container */
        body, html {
            overflow-x: hidden !important;
            width: 100vw !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        
        /* Xóa tất cả kích thước cố định cho các container */
        .content-wrapper, .main-content, [layout\:fragment="content"], .profile-container {
            width: 100vw !important;
            max-width: 100vw !important;
            padding: 0 !important;
            margin: 0 !important;
            left: 0 !important;
            right: 0 !important;
            box-sizing: border-box !important;
        }
        
        /* Reset cho layout 2 cột, khắc phục vấn đề space */
        .two-column-layout {
            width: 100% !important;
            display: flex !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        
        /* Loại bỏ các padding không cần thiết */
        .column {
            padding: 10px !important;
        }

        /* Đặt chiều rộng cố định cho sidebar nếu nó đang hiển thị */
        #floatingSidebar.active {
            width: 320px !important; 
        }

        #floatingSidebar:not(.active) {
            width: 0 !important;
        }
        
        /* Ẩn overflow-x để không bị scroll ngang */
        body {
            overflow-x: hidden !important;
        }
        
        /* Thêm debug outline */
        .two-column-layout { outline: 2px solid red; }
        .info-column { outline: 2px solid blue; }
        .feedback-column { outline: 2px solid green; }
    </style>
    <link rel="stylesheet" th:href="@{/css/shipper/shipper.css}" />
</head>

<body>
    
    <div layout:fragment="content">
        <div class="profile-container">
            <!-- Header Section -->
            <div class="header">
                <div class="profile-avatar">👤</div>
                <h1 class="shipper-name" id="shipperName">PHAN MINH HIẾU</h1>
                <p class="shipper-id">ID: #SH102230345</p>
            </div>

            <!-- New layout: Horizontal split layout -->
            <div class="two-column-layout">
                <!-- Left column - Info Section -->
                <div class="column info-column">
                    <div class="info-section">
                        <h2 class="section-title">
                            <i class="fas fa-clipboard-list"></i>
                            Thông Tin Cá Nhân
                        </h2>
                        
                        <div class="info-item">
                            <span class="info-label">Trạng thái:</span>
                            <span class="status-badge" id="status">Đang hoạt động</span>
                        </div>
                        
                        <div class="info-item">
                            <span class="info-label">Số điện thoại:</span>
                            <span class="info-value">1234567890</span>
                        </div>
                        
                        <div class="info-item">
                            <span class="info-label">Email:</span>
                            <span class="info-value">hieuphan@gmail.com</span>
                        </div>
                        
                        <div class="info-item">
                            <span class="info-label">Phương tiện:</span>
                            <span class="info-value">Xe máy - 29A1-12345</span>
                        </div>
                        
                        <div class="info-item">
                            <span class="info-label">Ngày tham gia:</span>
                            <span class="info-value">15/03/2023</span>
                        </div>
                        

                        <!-- Biểu đồ hiệu suất -->
                        <div class="performance-chart">
                            <h3 class="section-title">
                                <i class="fas fa-chart-bar"></i>
                                Hiệu Suất
                            </h3>
                            
                            <div class="chart-bar">
                                <div class="chart-label">Đúng giờ:</div>
                                <div class="chart-progress">
                                    <div class="chart-fill" style="width: 95%"></div>
                                </div>
                                <div class="chart-value">95%</div>
                            </div>
                            
                            <div class="chart-bar">
                                <div class="chart-label">Thành công:</div>
                                <div class="chart-progress">
                                    <div class="chart-fill" style="width: 98%"></div>
                                </div>
                                <div class="chart-value">98%</div>
                            </div>
                            
                            <div class="chart-bar">
                                <div class="chart-label">Hài lòng:</div>
                                <div class="chart-progress">
                                    <div class="chart-fill" style="width: 96%"></div>
                                </div>
                                <div class="chart-value">96%</div>
                            </div>
                        </div>
                    </div>
                </div>
                

    <!-- Fragment for script -->
    <th:block layout:fragment="script">
        <script>
            // Dữ liệu mẫu cho feedback (mô phỏng dữ liệu từ backend)
            const feedbackData = [
                
            ];

            // Hàm tạo sao đánh giá
            function createStars(rating) {
                let stars = '';
                for (let i = 1; i <= 5; i++) {
                    stars += i <= rating ? '★' : '☆';
                }
                return stars;
            }

            // Hàm render feedback
            function renderFeedback() {
                const feedbackList = document.getElementById('feedbackList');
                
                feedbackData.forEach(feedback => {
                    const feedbackItem = document.createElement('div');
                    feedbackItem.className = 'feedback-item';
                    
                    feedbackItem.innerHTML = `
                        <div class="feedback-header">
                            <div class="customer-info">
                                <div class="customer-avatar">${feedback.customerAvatar}</div>
                                <div>
                                    <div class="customer-name">${feedback.customerName}</div>
                                    <div class="feedback-date">${feedback.date}</div>
                                </div>
                            </div>
                        </div>
                        <div class="feedback-rating">
                            <span class="stars">${createStars(feedback.rating)}</span>
                            <span class="rating-number">(${feedback.rating}/5)</span>
                        </div>
                        <div class="feedback-text">"${feedback.comment}"</div>
                    `;
                    
                    feedbackList.appendChild(feedbackItem);
                });
            }

            // Khởi tạo trang
            document.addEventListener('DOMContentLoaded', function() {
                renderFeedback();
                
                // Mô phỏng cập nhật trạng thái real-time
                setInterval(() => {
                    const statusElement = document.getElementById('status');
                    const isOnline = Math.random() > 0.3; // 70% chance online
                    
                    if (isOnline) {
                        statusElement.textContent = 'Đang hoạt động';
                        statusElement.className = 'status-badge';
                    } else {
                        statusElement.textContent = 'Không hoạt động';
                        statusElement.className = 'status-badge offline';
                    }
                }, 10000); // Cập nhật mỗi 10 giây
            });
        </script>
    </th:block>
</body>
</html>